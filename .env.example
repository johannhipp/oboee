BETTER_AUTH_SECRET=
SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MPP_SECRET_KEY=
OBOE_MONEY_WRITES_ENABLED=false
OBOE_SERVER_ENVELOPE_SECRET=
OBOE_PUBLIC_URL=http://localhost:3000
MPP_RECIPIENT_ESCROW_ADDRESS=
MPP_ENABLE_FEE_PAYER=false
# Use a Tempo key address (spending key), not the wallet custody address.
MPP_FEE_PAYER_PRIVATE_KEY=
# Configure only a non-production token/network for local and automated runs.
MPP_FUNDING_TOKEN_ADDRESS=
MPP_NETWORK=
# Optional explicit RPC used by isolated nonproduction MPP verification.
OBOE_MPP_RPC_URL=
# Policy-v2 creation remains off/shadow/cohort unless both the database flag and
# this deployment-level gate permit general availability.
OBOE_V2_GENERAL_AVAILABILITY_APPROVED=false
OBOE_PLATFORM_PRINCIPAL_ID=
# Both values are required before the internal nonproduction cohort bootstrap
# can run. Never enable these in production.
OBOE_ENVIRONMENT=
OBOE_NONPRODUCTION_BOOTSTRAP_ENABLED=false
# Restricted evidence is envelope-encrypted by this external KMS boundary.
OBOE_KMS_URL=
OBOE_KMS_AUTH_TOKEN=
OBOE_SCANNER_URL=
OBOE_SCANNER_AUTH_TOKEN=
# Settlement broadcasts and receipt reconciliation use this custody boundary.
OBOE_CUSTODY_URL=
OBOE_CUSTODY_AUTH_TOKEN=
OBOE_CUSTODY_SENDER_ADDRESS=
OBOE_SETTLEMENT_CONFIRMATIONS=1
