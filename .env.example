BETTER_AUTH_SECRET=
SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MPP_SECRET_KEY=
MPP_NETWORK=tempo-moderato
MPP_RECIPIENT_ESCROW_ADDRESS=
# CLI-only guard used by scripts/pay.sh; set it to the same escrow address.
OBOE_EXPECTED_ESCROW_ADDRESS=
MPP_ENABLE_FEE_PAYER=false
# Use a Tempo key address (spending key), not the wallet custody address.
MPP_FEE_PAYER_PRIVATE_KEY=
# Tempo Moderato pathUSD (chain 42431). The MVP rejects every other token/network.
MPP_FUNDING_TOKEN_ADDRESS=0x20c0000000000000000000000000000000000000
OBOE_MPP_RPC_URL=https://rpc.moderato.tempo.xyz
# Set the same 32+ character value in the Next.js and Convex environments.
OBOE_PAYMENT_RECORDING_SECRET=
# Required only for explicit development fixture commands.
OBOE_SEED_SECRET=
